{
  "policy_version": 1,
  "agent_id": "project-hermes",
  "rules": [
    {
      "id": "reply-assigned-delivered-task",
      "operation": "reply",
      "max_text_bytes": 20000,
      "attachments": {
        "enabled": true,
        "allowed_roots": [
          "/home/ubuntu/projects/hermes/project-hermes-worker/artifacts",
          "/home/ubuntu/projects/ops/collab_workspace/05-agent-outputs/project-hermes"
        ],
        "allowed_mime_types": [
          "application/json",
          "application/pdf",
          "application/octet-stream",
          "image/jpeg",
          "image/png",
          "text/csv",
          "text/markdown",
          "text/plain"
        ],
        "max_files": 4,
        "max_total_bytes": 16777216
      },
      "side_effects": "none"
    },
    {
      "id": "report-assigned-task-failure",
      "operation": "fail_task",
      "allowed_reasons": ["agent_reported_failure"],
      "side_effects": "none"
    },
    {
      "id": "complete-requester-owned-task",
      "operation": "complete_task",
      "side_effects": "none"
    }
  ],
  "denied_operations": [
    "create_task",
    "create_followup",
    "amend_task",
    "change_participants"
  ]
}
